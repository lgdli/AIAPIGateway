# ========================================
# AI API Gateway 环境变量配置
# ========================================
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ========================================
# 核心配置（必须修改）
# ========================================

# 会话密钥 - 必须修改为随机字符串
# 生成方法: openssl rand -hex 32
SESSION_SECRET=change-this-to-your-random-secret-key

# ========================================
# 数据库配置
# ========================================

# MySQL root 密码（管理员密码）
MYSQL_ROOT_PASSWORD=change-this-root-password

# 应用数据库配置
MYSQL_DATABASE=aiapi
MYSQL_USER=aiapi
MYSQL_PASSWORD=change-this-user-password

# 数据库连接字符串（应用使用）
# 格式: user:password@tcp(host:port)/database?options
# 注意: 使用上面设置的 MYSQL_USER 和 MYSQL_PASSWORD
SQL_DSN=aiapi:change-this-user-password@tcp(mysql:3306)/aiapi?charset=utf8mb4&parseTime=True&loc=Local

# ========================================
# Redis 配置
# ========================================

# Redis 连接URL
REDIS_URL=redis://redis:6379

# 如需密码（生产环境建议）
# REDIS_URL=redis://:your_redis_password@redis:6379

# ========================================
# 服务配置
# ========================================

# 应用端口（容器内部）
PORT=3000

# 时区
TZ=Asia/Shanghai

# ========================================
# phpMyAdmin 配置（可选）
# ========================================

# phpMyAdmin root 密码（与 MYSQL_ROOT_PASSWORD 一致）
PMA_PASSWORD=change-this-root-password

# ========================================
# 域名配置（生产环境）
# ========================================

# 你的域名（用于 SSL 证书）
# DOMAIN=your-domain.com

# ========================================
# 邮件配置（可选 - 用于通知）
# ========================================

# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com

# ========================================
# 第三方服务（可选）
# ========================================

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# WeChat OAuth
# WECHAT_CLIENT_ID=your-wechat-client-id
# WECHAT_CLIENT_SECRET=your-wechat-client-secret

# ========================================
# 安全提示
# ========================================
# 1. 不要提交 .env 文件到版本控制
# 2. 生产环境使用强密码（至少16位，包含大小写字母、数字、符号）
# 3. 定期更换密码和密钥
# 4. 限制文件权限: chmod 600 .env
